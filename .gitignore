# Dependencies
node_modules/

# Build output
frontend/dist/
dist/
build/

# Logs
*.log
logs/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.local

# Environment / secrets
.env
.env.*

